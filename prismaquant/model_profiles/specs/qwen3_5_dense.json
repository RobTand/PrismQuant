{
  "_lane_retirement_note": "nvfp4_cb removed 2026-09-02: the Gridbook codebook lane was retired (archive/gridbook_lane_2026-09-02/). This profile's CB declarations are deleted rather than left dangling -- a supported_lanes entry is a promise that a pinned runtime serves those bytes, and none does.",
  "schema": "prismaquant.model_structure.v1",
  "id": "qwen3_5_dense",
  "priority": 100,
  "supported_lanes": ["compressed-tensors"],
  "default_serving_profile": "vllm_packed_moe",
  "runtime_requirements": {
    "fast_kernel_packages": [
      {
        "module": "causal_conv1d",
        "package": "causal-conv1d (Dao-AILab/causal-conv1d)"
      },
      {
        "module": "fla",
        "package": "flash-linear-attention (fla-org/flash-linear-attention)"
      }
    ]
  },
  "match": {
    "model_type": ["qwen3_5", "qwen3_6"],
    "architectures": ["Qwen3_5For*", "Qwen3.5For*", "Qwen3_6For*", "Qwen3.6For*"],
    "architectures_exclude": ["*Moe*"]
  },
  "staging": {
    "text_only_strip_keys": [
      "vision_config",
      "audio_config",
      "speech_config",
      "image_token_id",
      "video_token_id",
      "vision_start_token_id",
      "vision_end_token_id"
    ],
    "promote_inner_model_type": true
  },
  "shard_regexes": {
    "visual_config_key": "vision_config",
    "visual_layer_prefix": "model.visual.blocks",
    "mtp_extra_linear_names": ["mtp.fc"]
  },
  "naming": {
    "live_to_recipe": [
      {
        "strip_prefix": "model.language_model.",
        "add_prefix": "model."
      }
    ],
    "recipe_to_source": [
      {
        "prefix": "mtp.",
        "replace": "mtp.",
        "stop": true
      },
      {
        "prefix": "model.visual.",
        "replace": "model.visual.",
        "stop": true
      },
      {
        "prefix": "model.language_model.",
        "replace": "model.language_model.",
        "stop": true
      },
      {
        "prefix": "model.",
        "replace": "model.language_model."
      }
    ],
    "recipe_to_vllm": [
      {
        "prefix": "mtp.",
        "replace": "mtp.",
        "stop": true
      },
      {
        "exact": "lm_head",
        "replace": "language_model.lm_head",
        "stop": true
      },
      {
        "prefix": "model.visual.",
        "replace": "visual.",
        "stop": true
      },
      {
        "prefix": "model.language_model.",
        "replace": "language_model.model."
      },
      {
        "prefix": "model.",
        "replace": "language_model.model."
      }
    ]
  },
  "naming_variants": [
    {
      "when": {
        "architectures": [
          "Qwen3_5ForCausalLM", "Qwen3_6ForCausalLM",
          "Qwen3.5ForCausalLM", "Qwen3.6ForCausalLM"
        ],
        "architectures_exclude": ["*Moe*"]
      },
      "naming": {
        "recipe_to_vllm": [
          { "prefix": "mtp.", "replace": "mtp.", "stop": true },
          { "exact": "lm_head", "replace": "lm_head", "stop": true },
          {
            "prefix": "model.language_model.",
            "replace": "model.",
            "stop": true
          },
          { "prefix": "model.", "replace": "model.", "stop": true }
        ]
      }
    }
  ],
  "fused_groups": [
    {
      "target": "self_attn.qkv_proj",
      "members": ["self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj"]
    },
    {
      "target": "mlp.gate_up_proj",
      "members": ["mlp.gate_proj", "mlp.up_proj"]
    },
    {
      "target": "linear_attn.in_proj_qkvz",
      "members": ["linear_attn.in_proj_qkv", "linear_attn.in_proj_z"]
    },
    {
      "target": "linear_attn.in_proj_ba",
      "members": ["linear_attn.in_proj_b", "linear_attn.in_proj_a"]
    }
  ],
  "packed_experts": {
    "param_names": [],
    "split_for_formats": []
  },
  "passthrough_prefixes": ["model.visual.", "mtp."],
  "pinned_names": ["lm_head"]
}
