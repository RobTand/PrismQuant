{
  "schema": "prismaquant.model_structure.v1",
  "id": "deepseek_v4",
  "priority": 170,
  "_default_serving_profile_rationale": "DSv4 uses the conservative packed-MoE allocation contract for both the native and Gridbook CB export lanes. Declaring nothing would resolve to `research`, which carries NO format allow-list, so any menu format could pass the serving gate on a 304B artifact. Dense `fused_groups` stay empty deliberately: Gridbook constructs a role composite and may decode each source sibling from a different codebook format before the common FP8 execution path; any compressed-tensors-only uniformity rule must be enforced by that lane rather than globally coupling the producer allocation.",
  "default_serving_profile": "vllm_packed_moe",
  "supported_lanes": [
    "compressed-tensors",
    "nvfp4_cb"
  ],
  "preferred_lane": "compressed-tensors",
  "match": {
    "model_type": [
      "deepseek_v4",
      "deepseek-v4"
    ],
    "architectures": [
      "DeepseekV4*",
      "DeepSeek-V4*"
    ]
  },
  "shard_regexes": {
    "body_layer_prefix": "layers",
    "mtp_layer_prefix": "mtp",
    "lm_head_name": "head"
  },
  "naming": {
    "recipe_to_source": [
      {
        "exact": "lm_head.weight",
        "replace": "head.weight",
        "stop": true
      },
      {
        "exact": "model.embed_tokens.weight",
        "replace": "embed.weight",
        "stop": true
      },
      {
        "exact": "model.norm.weight",
        "replace": "norm.weight",
        "stop": true
      },
      {
        "prefix": "model.",
        "replace": ""
      },
      {
        "regex": "(^|\\.)layers\\.(\\d+)\\.self_attn\\.",
        "replace": "\\1layers.\\2.attn."
      },
      {
        "regex": "(^|\\.)layers\\.(\\d+)\\.mlp\\.",
        "replace": "\\1layers.\\2.ffn."
      },
      {
        "regex": "(^|\\.)layers\\.(\\d+)\\.attn_hc\\.",
        "replace": "\\1layers.\\2.hc_attn_"
      },
      {
        "regex": "(^|\\.)layers\\.(\\d+)\\.ffn_hc\\.",
        "replace": "\\1layers.\\2.hc_ffn_"
      },
      {
        "regex": "ffn\\.shared_experts\\.gate_proj\\.",
        "replace": "ffn.shared_experts.w1."
      },
      {
        "regex": "ffn\\.shared_experts\\.up_proj\\.",
        "replace": "ffn.shared_experts.w3."
      },
      {
        "regex": "ffn\\.shared_experts\\.down_proj\\.",
        "replace": "ffn.shared_experts.w2."
      },
      {
        "regex": "ffn\\.experts\\.([0-9]+)\\.gate_proj\\.",
        "replace": "ffn.experts.\\1.w1."
      },
      {
        "regex": "ffn\\.experts\\.([0-9]+)\\.up_proj\\.",
        "replace": "ffn.experts.\\1.w3."
      },
      {
        "regex": "ffn\\.experts\\.([0-9]+)\\.down_proj\\.",
        "replace": "ffn.experts.\\1.w2."
      }
    ]
  },
  "fused_groups": [],
  "packed_experts": {
    "param_names": [
      "gate_up_proj",
      "down_proj"
    ],
    "split_for_formats": [
      "*"
    ],
    "projection_splits": {
      "gate_up_proj": [
        "gate_proj",
        "up_proj"
      ]
    },
    "format_groups": [
      [
        "gate_up_proj",
        "down_proj"
      ],
      [
        "gate_proj",
        "up_proj",
        "down_proj"
      ],
      [
        "w1",
        "w2",
        "w3"
      ]
    ]
  },
  "moe": {
    "unpacked_expert_projection_names": [
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "per_expert_regex": "re:^model[.]layers[.][0-9]+[.]mlp[.]experts[.][0-9]+[.](gate|up|down)_proj$",
    "per_expert_mtp_regex": "re:^model[.]mtp[.][0-9]+[.]mlp[.]experts[.][0-9]+[.](gate|up|down)_proj$"
  },
  "probe": {
    "skip_module_class_names": [],
    "grouped_module_class_names": [
      "DeepseekV4GroupedLinear"
    ]
  },
  "passthrough_prefixes": [
    "mtp.",
    "attn_sink",
    "hc_",
    "compressor.ape",
    "tid2eid",
    "kv_norm",
    "q_norm",
    "norm."
  ],
  "pinned_names": [
    "lm_head",
    "head"
  ],
  "_verified_source_layout": {
    "verified": "2026-07-30, against deepseek-ai/DeepSeek-V4-Flash safetensors headers (4 shards) + the authors' inference/convert.py",
    "config": {
      "expert_dtype": "fp4 on DeepSeek-V4-Flash, fp8 on DeepSeek-V4-Flash-Base (top level, not under text_config)",
      "quantization_config.scale_fmt": "ue8m0",
      "quantization_config.weight_block_size": [
        128,
        128
      ]
    },
    "tensor_dtypes": {
      "routed_expert_weight": "I8 nibble-pack, e.g. layers.N.ffn.experts.{i}.w1.weight [2048, 2048] = logical [2048, 4096]",
      "routed_expert_scale": "F8_E8M0, [2048, 128] = one scale per 32 logical elements along the reduce dim",
      "shared_expert_weight": "F8_E4M3 block-FP8 (NOT a nibble-pack) \u2014 layers.N.ffn.shared_experts.w1.weight",
      "shared_expert_scale": "F8_E8M0 over 128x128 blocks",
      "attention_weight": "F8_E4M3 + F8_E8M0 scale; norms/router BF16/F32"
    },
    "notes": [
      "Scales are 1-byte E8M0 planes named `.scale`, NOT fp32 `.weight_scale_inv` \u2014 the regime-wide fp8 source-byte rate assumes fp32 128x128 scales and over-counts here, so byte accounting for this checkpoint MUST use the per-tensor manifest.",
      "Checkpoint keys have no `model.` prefix: they start at `layers.N.`.",
      "E2M1 code table and low-nibble-first packing confirmed against inference/convert.py FP4_TABLE.",
      "expert_dtype covers ROUTED experts only; the shared expert is block-FP8."
    ]
  }
}
