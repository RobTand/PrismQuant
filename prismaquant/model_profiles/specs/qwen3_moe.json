{
  "schema": "prismaquant.model_structure.v1",
  "id": "qwen3_moe",
  "priority": 120,
  "default_serving_profile": "vllm_packed_moe",
  "match": {
    "model_type": ["qwen3_moe"],
    "architectures": ["Qwen3Moe*"]
  },
  "fused_groups": [
    {
      "target": "self_attn.qkv_proj",
      "members": ["self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj"]
    },
    {
      "target": "mlp.gate_up_proj",
      "members": ["mlp.gate_proj", "mlp.up_proj"]
    },
    {
      "target": "mlp.shared_expert.gate_up_proj",
      "members": ["mlp.shared_expert.gate_proj", "mlp.shared_expert.up_proj"]
    }
  ],
  "packed_experts": {
    "param_names": ["gate_up_proj", "down_proj"],
    "split_for_formats": ["*"],
    "projection_splits": {
      "gate_up_proj": ["gate_proj", "up_proj"]
    },
    "format_groups": [
      ["gate_up_proj", "down_proj"],
      ["gate_proj", "up_proj", "down_proj"],
      ["w1", "w2", "w3"]
    ]
  },
  "moe": {
    "per_expert_regex": "re:^model[.]layers[.][0-9]+[.]mlp[.]experts[.][0-9]+[.](gate|up|down)_proj$"
  },
  "passthrough_prefixes": [],
  "pinned_names": ["lm_head"]
}
