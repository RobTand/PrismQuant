{
  "schema": "prismaquant.tessera_serving_runtime_pin.v2",
  "repository": "https://github.com/RobTand/tessera.git",
  "commit": "8ed1d9a78b3f0c7036dcbe14d7df3a89f398812a",
  "version": "0.1.0",
  "version_is_release": false,
  "contract_sha256": "719daa02da1564b56a141ca2702ae29d4fda553460978efbb6510ddcd1824927",
  "runtime_contract_schema": "tessera.runtime-contract.v1",
  "plugin_entry_point": "tessera = tessera.serving:register",
  "serving_residency_env": "TESSERA_SERVE_MODE",
  "serving_native_extensions": [
    {
      "module_name_prefix": "tessera_nvfp4_",
      "filename_glob": "tessera_nvfp4_*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "torch_materialize_stock"
        },
        "streamed": {
          "status": "refused",
          "decoder": null
        }
      }
    },
    {
      "module_name_prefix": "tessera_window_gemv",
      "filename_glob": "tessera_window_gemv*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "torch_window"
        },
        "streamed": {
          "status": "substituted",
          "decoder": "torch_window"
        }
      }
    }
  ]
}
